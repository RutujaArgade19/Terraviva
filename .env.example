# Configure as server-only Vercel environment variables. Never commit real values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 random bytes encoded as 64 hex characters
DEPOT_ENCRYPTION_KEY=
# JSON array of administrator-issued token SHA256 hashes and fixed farm identities
DEPOT_ACCESS_JSON=[]
TWILIO_AUTH_TOKEN=
# Exact publicly accessible HTTPS URL configured on the Twilio number
TWILIO_WEBHOOK_URL=
# JSON object mapping verified enrolled E.164 phone numbers to farm IDs
SMS_FARM_MAP_JSON={}
# Ingest-only sensor/gateway token hashes bound to a fixed farm and device.
# Example shape: [{"tokenHash":"<sha256>","farm":"farm-id","deviceId":"device-id","field":"North Field","enabled":true}]
# Keep real device bearer tokens on enrolled devices/gateways, never in the browser bundle.
SENSOR_DEVICE_ACCESS_JSON=[]

